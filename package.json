{
  "name": "optical-artifact-transport",
  "private": true,
  "version": "0.1.0",
  "description": "OAT: browser-native optical-send/optical-receive web components for screen-to-camera artifact transport",
  "type": "module",
  "workspaces": [
    "packages/protocol",
    "packages/codecs/qr-fountain",
    "packages/sim",
    "packages/sender",
    "packages/receiver",
    "packages/ui",
    "packages/bootstrap",
    "examples/file-transfer"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "dev:demo": "npm run dev -w examples/file-transfer",
    "example:01": "node examples/01-round-trip.mjs",
    "example:02": "node examples/02-lossy-channel.mjs",
    "example:03": "node examples/03-signed-verify-reject.mjs",
    "example:04": "node examples/04-bootstrap-manifest.mjs",
    "examples": "npm run example:01 && npm run example:02 && npm run example:03 && npm run example:04",
    "start": "serve -l tcp://0.0.0.0:${PORT:-3000} examples/file-transfer/dist",
    "publish:packages": "./scripts/staggered-publish.sh",
    "publish:packages:dry-run": "./scripts/staggered-publish.sh --dry-run"
  },
  "dependencies": {
    "serve": "^14.2.4"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.62",
    "esbuild": "0.21.5",
    "happy-dom": "^15.11.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
