    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@oat/protocol": "*",
    "@oat/qr-fountain": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
